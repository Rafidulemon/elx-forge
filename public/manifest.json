{
  "manifest_version": 3,
  "name": "ELX Forge",
  "version": "0.1.0",
  "description": "Developer tool for CRO engineers — inject custom JS & CSS into websites for A/B testing, debugging and prototyping.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ELX Forge",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}